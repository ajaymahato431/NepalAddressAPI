APP_NAME="NepalAddressAPI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# NepalAddressAPI operates out-of-the-box with file-based data & caching.
# Database is optional for address queries.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=database/database.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# File-based caching provides fast responses without DB dependencies
CACHE_STORE=file
CACHE_PREFIX=nepal_address_

# Optional: CORS configuration if needed
# CORS_ALLOWED_ORIGINS="*"
